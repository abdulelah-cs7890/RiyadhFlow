{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/"
      ],
      "startServerCommand": "npm run start -- -p 3000 -H 127.0.0.1",
      "startServerReadyPattern": "started server",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "installable-manifest": ["error", { "minScore": 1 }],
        "apple-touch-icon": ["error", { "minScore": 1 }],
        "themed-omnibox": ["error", { "minScore": 1 }],
        "color-contrast": ["error", { "minScore": 1 }],
        "image-alt": ["error", { "minScore": 1 }],
        "viewport": ["error", { "minScore": 1 }],
        "uses-text-compression": ["warn", { "minScore": 1 }],
        "unused-javascript": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
